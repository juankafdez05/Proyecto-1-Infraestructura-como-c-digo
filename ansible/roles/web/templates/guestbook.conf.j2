# Gestionado por Ansible
<VirtualHost *:80>
    ServerName {{ web_servername }}
    DocumentRoot {{ web_docroot }}

    <Directory {{ web_docroot }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # No servir el repositorio git de la aplicación
    RedirectMatch 404 /\.git

    ErrorLog ${APACHE_LOG_DIR}/guestbook-error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook-access.log combined
</VirtualHost>
